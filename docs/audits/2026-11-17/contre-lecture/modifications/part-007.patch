+    def test_22x_any_storage_exception_stops_with_a_receipt(self):
+        from vega import artwork
+
+        class ClientError(Exception):
+            """botocore's, for this test: not a MediaError."""
+
+        calls = []
+
+        def put(key, body, kind):
