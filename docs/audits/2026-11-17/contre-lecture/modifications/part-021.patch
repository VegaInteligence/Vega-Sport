diff --git a/tests/archive-association-sides.test.mjs b/tests/archive-association-sides.test.mjs
new file mode 100644
index 0000000000..50ee11cf96
--- /dev/null
+++ b/tests/archive-association-sides.test.mjs
@@ -0,0 +1,24 @@
+// FAILURE_MODES.md §23 (23n), written before the code: in an OpenFootball UEFA results row, whose team names carry their
+// association (« Real Madrid (ESP) »), a goal's team is compared, after exact names, with each name without its suffix.
+// One side only may match; the stored names keep their suffix; no other feed is read this way.
+import test from "node:test";
+import assert from "node:assert/strict";
+import { goalSide } from "../dashboard/shared/archive.js";
+
+const uefa = (team1, team2, competitionId = "2013-14/uefa.cl") => ({ competitionId, team1, team2 });
+
+test("23n: the association suffix of an OpenFootball UEFA row is read for the goal's side", () => {
+  assert.equal(goalSide({ team: "Real Madrid" }, uefa("Real Madrid (ESP)", "Atlético Madrid (ESP)")), "home");
+  assert.equal(goalSide({ team: "Atlético Madrid" }, uefa("Real Madrid (ESP)", "Atlético Madrid (ESP)")), "away");
+  assert.equal(goalSide({ team: "Dinamo Zagreb" }, uefa("Dinamo Zagreb (CRO)", "Dinamo Kiev (UKR)", "2012-13/uefa.cl")), "home");
+  assert.equal(goalSide({ team: "Dinamo Kiev" }, uefa("Dinamo Zagreb (CRO)", "Dinamo Kiev (UKR)", "2012-13/uefa.cl")), "away");
+});
+
+test("23n: ambiguous or other feeds stay as they were", () => {
+  // Both sides with one base name: unknown.
+  assert.equal(goalSide({ team: "Dinamo" }, uefa("Dinamo (CRO)", "Dinamo (UKR)")), null);
+  // Not an OpenFootball UEFA row: the suffix is a name, read by similarity as before (a tie stays unknown).
+  assert.equal(goalSide({ team: "Real Madrid" }, uefa("Real Madrid (ESP)", "Atlético Madrid (ESP)", "england/2013-14/eng.1")), null);
+  // Lower-case or longer codes are not an association.
+  assert.equal(goalSide({ team: "Real Madrid" }, uefa("Real Madrid (esp)", "Atlético Madrid (esp)")), null);
+});
diff --git a/tests/archive-corrections.test.mjs b/tests/archive-corrections.test.mjs
new file mode 100644
index 0000000000..00176457f9
--- /dev/null
+++ b/tests/archive-corrections.test.mjs
@@ -0,0 +1,84 @@
+// FAILURE_MODES.md §22 (22d, 22e, 22f, legacy pin), written before the code: the published rows are rebuilt by
+// the baseline code itself, a unit whose keys or scores the corrected reading would change keeps its legacy rows,
+// and a goal's side is first the side named exactly.
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { buildArchiveSeason, goalSide } from "../dashboard/shared/archive.js";
+
+const event = (date, match, minute, player, team, score) => ({ date, match, minute, player, team, score });
+const goals = (id, events) => ({ season: "2000/2001", competitions: [{ id, name: id, country: "Österreich", events }] });
+const byKey = (edition) => Object.fromEntries(edition.matches.map((m) => [m.key, m]));
+
+test("the legacy reading is the baseline's own files, byte for byte", () => {
+  // git show 8018e0836c:dashboard/shared/<file> | shasum -a 256
+  const pinned = {
+    "archive.js": "296e7abe672b5617e49eb05c5fb9253ea713a924237a8db8697b064f2db4df44",
+    "openfootball-history.js": "a03306601834994bc081ee6e94e46a60f6e8aca9f86797679dc1b1fcb9973e31",
+    "archive-text.js": "9fd698d0a2a8b401ec97b6c63d1cc5e8d773c75e04d6cb11206bd8e3970cec22",
+  };
+  for (const [name, digest] of Object.entries(pinned)) {
+    const body = readFileSync(new URL(`../dashboard/shared/legacy-8018e08/${name}`, import.meta.url));
+    assert.equal(createHash("sha256").update(body).digest("hex"), digest, name);
+  }
+});
+
+test("22d: a legacy-readable label whose corrected score differs keeps its legacy row, held", () => {
+  // Astra's literal: one observed goal at 50' ending 2–1 under « M vs. N 3:1 (Hinspiel 0:0) ».
+  const edition = buildArchiveSeason(null, goals("x", [event("2000-09-01", "M vs. N 3:1 (Hinspiel 0:0)", "50", "P", "M", [2, 1])]));
+  const [row] = edition.matches;
+  assert.equal(row.key, "g:x:2000-09-01:0");
+  assert.deepEqual(row.score, [2, 1]); // the published (legacy) score
+  assert.deepEqual(row.notes, ["tirs au but"]); // the published notes
+  assert.equal(row.held, "score_change");
+  assert.deepEqual(row.candidate?.score, [3, 1]); // the corrected reading, reported only
+});
+
+test("22e: an absorption the legacy reading did not make keeps both legacy keys, the result without these goals", () => {
+  const results = {
+    season: "2000/2001",
+    competitions: [{ id: "at.1", name: "Bundesliga", country: "Österreich", matches: [
+      { date: "2000-09-02", team1: "Wiener", team2: "Rapid", score: { ft: [3, 1] } },
+    ] }],
+  };
+  const edition = buildArchiveSeason(results, goals("aut", [event("2000-09-02", "Wien vs. Rapid 3:1 (Hinspiel 0:0)", "50", "P", "Wien", [2, 1])]));
+  const rows = byKey(edition);
+  assert.deepEqual(Object.keys(rows).sort(), ["g:aut:2000-09-02:0", "r:at.1:0"]);
+  assert.equal(rows["r:at.1:0"].goals, null);
+  assert.equal(rows["g:aut:2000-09-02:0"].held, "absorption");
+  assert.deepEqual(rows["g:aut:2000-09-02:0"].score, [2, 1]);
+  assert.deepEqual(edition.absorbed, []); // nothing is absorbed
+  assert.deepEqual(edition.held.map((h) => [h.reason, h.legacy, h.candidate]), [
+    ["absorption", ["g:aut:2000-09-02:0", "r:at.1:0"], ["r:at.1:0"]],
+  ]);
+});
+
+test("22f: a goal's side is first the side named exactly", () => {
+  assert.equal(goalSide({ team: "Manchester United" }, { team1: "Manchester United", team2: "Manchester City" }), "home");
+  assert.equal(goalSide({ team: "Manchester City" }, { team1: "Manchester United", team2: "Manchester City" }), "away");
+  assert.equal(goalSide({ team: "Real Madrid" }, { team1: "Atlético Madrid", team2: "Real Madrid" }), "away");
+  assert.equal(goalSide({ team: "real  madrid." }, { team1: "Atlético Madrid", team2: "Real Madrid" }), "away"); // case, spaces, dots
+  assert.equal(goalSide({ team: "West Ham United" }, { team1: "Arsenal FC", team2: "West Ham United FC" }), "away"); // similarity
+  assert.equal(goalSide({ team: "Manchester" }, { team1: "Manchester United", team2: "Manchester City" }), null); // still a tie
+});
+
+test("22g (edition): a legacy side the corrected reading would lose holds the unit", () => {
+  // A parsed legacy label: the legacy side of each goal is established; the corrected rows must keep it.
+  const edition = buildArchiveSeason(null, goals("eng", [
+    event("2000-09-03", "Manchester United vs. Manchester City 1:0", "10", "P", "Manchester United", [1, 0]),
+  ]));
+  const [row] = edition.matches;
+  assert.equal(row.held, undefined);
+  assert.equal(row.goals[0].side, "home");
+});
+
+test("an unchanged unit is the corrected row; a malformed legacy label is repaired in place with its key", () => {
+  const edition = buildArchiveSeason(null, goals("dfb", [
+    event("1972-04-12", "1. FC Köln vs. Bayern München 5:1 \t\t\n\t(Hinspiel 0:3)", "80", "P2", "Bayern München", [5, 1]),
+  ]));
+  const [row] = edition.matches;
+  assert.equal(row.key, "g:dfb:1972-04-12:0");
+  assert.deepEqual([row.team1, row.team2, row.score, row.held], ["1. FC Köln", "Bayern München", [5, 1], undefined]);
+  assert.equal(row.goals[0].side, "away");
+});
diff --git a/tests/archive-goal-keys.test.mjs b/tests/archive-goal-keys.test.mjs
new file mode 100644
index 0000000000..e70e1a5f51
--- /dev/null
+++ b/tests/archive-goal-keys.test.mjs
@@ -0,0 +1,83 @@
+// FAILURE_MODES.md §20 (20f, 20h, 20i and the score-conflict hold), written before the code: a goal
+// label laid out on several lines is read, keys keep their legacy numbering, and label parsing never
+// chooses a score nor names an invented team.
+import test from "node:test";
+import assert from "node:assert/strict";
+import { buildArchiveSeason, parseGoalMatch } from "../dashboard/shared/archive.js";
+
+const event = (date, match, minute, player, team, score) => ({ date, match, minute, player, team, score });
+const season = (events, results = null) => buildArchiveSeason(results, {
+  season: "1971/1972", competitions: [{ id: "dfb-pokal", name: "DFB-Pokal", country: "Deutschland", events }],
+});
+const byKey = (edition) => Object.fromEntries(edition.matches.map((m) => [m.key, m]));
+
+test("a goal label laid out on several lines is read; the raw label is kept", () => {
+  // Production labels (17 Nov 2026, worldclub DFB-Pokal 1971/72).
+  assert.deepEqual(parseGoalMatch("1. FC Köln vs. Bayern München 5:1 \t\t\t\n\t\t\t\t\t\n\t\t\t(Hinspiel 0:3)"),
+    { team1: "1. FC Köln", team2: "Bayern München", score: [5, 1], suffix: "(Hinspiel 0:3)" });
+  assert.equal(parseGoalMatch("1. FC Kaiserslautern vs. Rot-Weiß Oberhausen 5:0 n.V.\t\t\n\t\t(Hinspiel 1:3)").suffix, "n.V. (Hinspiel 1:3)");
+  assert.deepEqual(parseGoalMatch("A vs. B 2:1"), { team1: "A", team2: "B", score: [2, 1], suffix: "" });
+  assert.deepEqual(parseGoalMatch("Werder Bremen vs. Hannover 96 2:1 i.E."), { team1: "Werder Bremen", team2: "Hannover 96", score: [2, 1], suffix: "i.E." });
+  assert.equal(parseGoalMatch("no label here"), null);
+});
+
+test("goal-only keys keep their legacy numbering; a merge the legacy reading did not make is held (§22)", () => {
+  const edition = season([
+    event("1972-04-05", "Clean A vs. Clean B 1:0", "10", "P1", "Clean A", [1, 0]),
+    // One match, captured once with layout whitespace (legacy: unread) and once clean (legacy: read).
+    // (The unread capture holds the final goal: its legacy score is the label's, so nothing is held.)
+    event("1972-04-12", "1. FC Köln vs. Bayern München 5:1 \t\t\n\t(Hinspiel 0:3)", "80", "P2", "1. FC Köln", [5, 1]),
+    event("1972-04-12", "1. FC Köln vs. Bayern München 5:1 (Hinspiel 0:3)", "5", "P3", "1. FC Köln", [1, 0]),
+    event("1972-04-19", "X vs. Y 2:2\n\t(Hinspiel 1:1)", "30", "P4", "X", [1, 0]),
+    event("1972-04-19", "X vs. Y 2:2\n\t(Hinspiel 1:1)", "60", "P5", "Y", [2, 2]),
+    event("1972-05-01", "garbage without a score", "1", "P6", "Somebody", [1, 0]),
+  ]);
+  const matches = byKey(edition);
+  assert.deepEqual(Object.keys(matches).sort(), [
+    "g:dfb-pokal:1972-04-05:0", "g:dfb-pokal:1972-04-12:1", "g:dfb-pokal:1972-04-12:2", "g:dfb-pokal:1972-04-19:3", "g:dfb-pokal:1972-05-01:4",
+  ]);
+  // §22: the two captures stay the two published rows, each with its own goal; nothing is absorbed.
+  assert.deepEqual([1, 2].map((i) => [matches[`g:dfb-pokal:1972-04-12:${i}`].held, matches[`g:dfb-pokal:1972-04-12:${i}`].goals.length]),
+    [["absorption", 1], ["absorption", 1]]);
+  assert.deepEqual(edition.absorbed, []);
+  assert.deepEqual(edition.held.map((h) => [h.reason, h.legacy, h.candidate]),
+    [["absorption", ["g:dfb-pokal:1972-04-12:1", "g:dfb-pokal:1972-04-12:2"], ["g:dfb-pokal:1972-04-12:2"]]]);
+  // Read now, same score as the legacy one: repaired in place, under its legacy key.
+  const xy = matches["g:dfb-pokal:1972-04-19:3"];
+  assert.deepEqual([xy.team1, xy.team2, xy.score, xy.held ?? null], ["X", "Y", [2, 2], null]);
+  // Never read: no team, the raw label shown.
+  const garbage = matches["g:dfb-pokal:1972-05-01:4"];
+  assert.deepEqual([garbage.team1, garbage.team2, garbage.unparsedLabel], ["", "", "garbage without a score"]);
+});
+
+test("a newly read label whose score differs from the legacy one keeps its legacy values", () => {
+  const edition = season([
+    event("1972-04-12", "M vs. N 3:1\n\t(Hinspiel 0:0)", "5", "P1", "M", [1, 0]),
+    event("1972-04-12", "M vs. N 3:1\n\t(Hinspiel 0:0)", "50", "P2", "M", [2, 1]),
+  ]);
+  const [match] = edition.matches;
+  assert.equal(match.key, "g:dfb-pokal:1972-04-12:0");
+  assert.equal(match.held, "score_change");
+  assert.deepEqual([match.team1, match.team2, match.score], ["M vs. N 3:1\n\t(Hinspiel 0:0)", "", [2, 1]]);
+});
+
+test("a legacy goal-only key whose goals would now join a results match is held, both rows kept (§22)", () => {
+  const results = { season: "1971/1972", competitions: [{ id: "de.cup", name: "DFB-Pokal", country: "Deutschland", matches: [
+    { date: "1972-04-12", team1: "1. FC Köln", team2: "Bayern München", score: { ft: [5, 1] } },
+  ] }] };
+  const edition = season([
+    event("1972-04-12", "1. FC Köln vs. Bayern München 5:1 \t\t\n\t(Hinspiel 0:3)", "80", "P2", "1. FC Köln", [5, 1]),
+  ], results);
+  assert.deepEqual(edition.matches.map((m) => [m.key, m.goals?.length ?? 0, m.held ?? m.heldGoals ?? null]).sort(),
+    [["g:dfb-pokal:1972-04-12:0", 1, "absorption"], ["r:de.cup:0", 0, "absorption"]]);
+  assert.deepEqual(edition.absorbed, []);
+});
+
+test("A–B and B–A the same day, and one pair in two competitions, stay distinct", () => {
+  const edition = buildArchiveSeason(null, { season: "1971/1972", competitions: [
+    { id: "a", name: "A", country: "X", events: [event("1972-04-12", "A vs. B 1:0", "5", "P1", "A", [1, 0]), event("1972-04-12", "B vs. A 0:2", "9", "P2", "A", [0, 1])] },
+    { id: "b", name: "B", country: "X", events: [event("1972-04-12", "A vs. B 1:0", "5", "P1", "A", [1, 0])] },
+  ] });
+  assert.equal(edition.matches.length, 3);
+  assert.deepEqual(edition.absorbed, []);
+});
