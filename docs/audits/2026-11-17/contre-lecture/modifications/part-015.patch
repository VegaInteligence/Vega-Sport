+        round: match.round || "",
+        team1: match.team1 || "",
+        team2: match.team2 || "",
+        score: historicalScore(match),
+        notes: historicalScoreNotes(match).filter(
+          (note) => !note.startsWith("Source"),
+        ),
+        goals: null,
+        raw: match,
+      });
+    });
+  }
