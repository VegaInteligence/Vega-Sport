+  if (/i\.?\s*E\.?/i.test(suffix)) notes.push("tirs au but");
+  return notes;
+}
+
+export function buildArchiveSeason(results, goals) {
+  const competitions = new Map();
+  const matches = [];
+  for (const league of results?.competitions || []) {
+    competitions.set(league.id, {
