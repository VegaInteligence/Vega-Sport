+++ b/backend/sql/136_cup_table_sides.sql
@@ -0,0 +1,34 @@
+-- A table row's two sides by its own foreign keys (VI-30, docs/calculs/09-audit-2026-11/FAILURE_MODES_VI30.md), for
+-- /api/cup-table and the table-v1 edition body: the public id of the team each FK names after one merged_into hop
+-- (a merge moves the matches and leaves a pointer to the kept team, never to another pointer: identity.py, 094),
+-- and that team's crest reference, which the site resolves through /api/assets. A name never chooses a crest.
+-- Additive: 127's columns in their order, then four at the end; one row per match as before.
+SET LOCAL lock_timeout = '3s';
+
+CREATE OR REPLACE VIEW api.cup_table_rows AS
+SELECT m.competition_season_id, split_part(cs.cup_key, ':', 2) AS competition, cs.native_label AS season, m.archive_position AS position,
+  m.status::text AS status, r.name AS gw, m.match_date AS date,
+  coalesce(m.home_team_name, ht.name) AS home, coalesce(m.away_team_name, awt.name) AS away,
+  m.home_score, m.away_score, m.home_score_ht, m.away_score_ht,
+  h.total_shots AS home_shots, a.total_shots AS away_shots, h.shots_on_target AS home_target, a.shots_on_target AS away_target,
+  h.fouls AS home_fouls, a.fouls AS away_fouls, h.corners AS home_corners, a.corners AS away_corners,
+  h1.corners AS home_corners_1h, a1.corners AS away_corners_1h, h2.corners AS home_corners_2h, a2.corners AS away_corners_2h,
+  h.yellow_cards AS home_yellow, a.yellow_cards AS away_yellow, h.red_cards AS home_red, a.red_cards AS away_red,
+  m.id AS match_id,
+  api.public_id('team', hk.id) AS home_team_public_id, hcr.source_url AS home_image_url,
+  api.public_id('team', ak.id) AS away_team_public_id, acr.source_url AS away_image_url
+FROM core.matches m
+JOIN core.competition_seasons cs ON cs.id = m.competition_season_id AND cs.cup_key LIKE 'open-matchday:%'
+LEFT JOIN core.rounds r ON r.id = m.round_id
+LEFT JOIN core.teams ht ON ht.id = m.home_team_id
+LEFT JOIN core.teams awt ON awt.id = m.away_team_id
+LEFT JOIN core.team_match_stats h ON h.season_id = m.season_id AND h.match_id = m.id AND h.team_id = m.home_team_id AND h.period = 'all'
+LEFT JOIN core.team_match_stats a ON a.season_id = m.season_id AND a.match_id = m.id AND a.team_id = m.away_team_id AND a.period = 'all'
+LEFT JOIN core.team_match_stats h1 ON h1.season_id = m.season_id AND h1.match_id = m.id AND h1.team_id = m.home_team_id AND h1.period = 'first_half'
+LEFT JOIN core.team_match_stats a1 ON a1.season_id = m.season_id AND a1.match_id = m.id AND a1.team_id = m.away_team_id AND a1.period = 'first_half'
+LEFT JOIN core.team_match_stats h2 ON h2.season_id = m.season_id AND h2.match_id = m.id AND h2.team_id = m.home_team_id AND h2.period = 'second_half'
+LEFT JOIN core.team_match_stats a2 ON a2.season_id = m.season_id AND a2.match_id = m.id AND a2.team_id = m.away_team_id AND a2.period = 'second_half'
+LEFT JOIN core.teams hk ON hk.id = coalesce(ht.merged_into, ht.id)
+LEFT JOIN core.assets hcr ON hcr.id = hk.crest_asset_id
+LEFT JOIN core.teams ak ON ak.id = coalesce(awt.merged_into, awt.id)
+LEFT JOIN core.assets acr ON acr.id = ak.crest_asset_id;
diff --git a/backend/sql/137_half_metric_coverage.sql b/backend/sql/137_half_metric_coverage.sql
new file mode 100644
index 0000000000..f928b7ff84
--- /dev/null
+++ b/backend/sql/137_half_metric_coverage.sql
@@ -0,0 +1,76 @@
+-- Each half metric's own coverage (calculation audit of 16 November 2026, finding 15c:
+-- « couverture et minutes observées par mesure, comme pour les agrégats saison principaux »;
+-- docs/calculs/09-audit-2026-11/FAILURE_MODES.md §4.1). api.player_half_totals (129) keeps the
+-- complete halves only and no group without one: a half that misses one metric loses all of
+-- its others, and a goalkeeper, whose halves publish no touches, has no season by half at all
+-- (17 November 2026, read-only: 216,659 of 2,738,261 eligible half rows left out, 15,342
+-- player-season-period groups hidden although they had positive passing). 129 is unchanged.
+--
+-- One row per (season, player, period) with an eligible half, complete or not: its match
+-- finished and its minutes positive, as in 129. matches and minutes count the eligible halves;
+-- excluded_matches and excluded_minutes those 129 leaves out, by its rule (equal to its columns
+-- wherever it has a row). Per metric of the route: <metric>_count, the eligible halves that know
+-- it; <metric>_minutes, their minutes (0 without any); <metric>_sum, its sum on them (NULL
+-- without any, never 0). A metric is known when it is not NULL; xG when it is finite, or blank
+-- on a half whose 0 shots are published (129's structural zero). A blank xG with unknown shots or
+-- with a shot, NaN, +∞ and −∞ are unknown.
+--
+-- xG precision (FAILURE_MODES §4.1, FM-HC.10–12; Astra review of 18 November 2026): each stored
+-- single-precision xG is read as the shortest decimal that reads back as the same stored value
+-- (0.12345679, never its binary 0.12345679104328156… nor real::numeric's 6 digits, 0.123457),
+-- whatever the reading session's extra_float_digits; these decimals are summed exactly (xg_sum is
+-- numeric) and the route converts the sum to a JSON number once. Corrected in place before any
+-- release: 137 was only on codex/audit-1-linear (c3c8232747), production runs 8018e0836c.
+SET LOCAL lock_timeout = '3s';
+
+-- The shortest decimal that reads back as the same single-precision value: PostgreSQL's own
+-- shortest output, which it gives only when extra_float_digits is above 0 (at 0, 6 digits).
+CREATE FUNCTION core.real_decimal(value real) RETURNS numeric
+LANGUAGE sql IMMUTABLE STRICT PARALLEL SAFE SET extra_float_digits = 1
+RETURN value::text::numeric;
+
+CREATE VIEW api.player_half_coverage AS
+WITH h AS (
+  SELECT h.season_id, h.player_id, h.period, h.minutes_played, h.goals, h.total_shots,
+    CASE WHEN h.xg IS NULL THEN CASE WHEN h.total_shots = 0 THEN 0::numeric END
+         WHEN h.xg NOT IN ('NaN', 'Infinity', '-Infinity') THEN core.real_decimal(h.xg) END AS xg,
+    h.accurate_passes, h.touches, h.duels_won, h.recoveries, h.touches_opp_box, h.dribbles_succeeded, h.tackles
+  FROM core.player_match_half_stats h
+  JOIN core.matches m ON m.id = h.match_id AND m.season_id = h.season_id AND m.status = 'finished'
+  WHERE h.minutes_played > 0
+), c AS (
+  SELECT h.*,
+    (h.touches IS NOT NULL AND h.goals IS NOT NULL AND h.total_shots IS NOT NULL AND h.xg IS NOT NULL
+     AND h.accurate_passes IS NOT NULL AND h.duels_won IS NOT NULL AND h.recoveries IS NOT NULL
+     AND h.touches_opp_box IS NOT NULL AND h.dribbles_succeeded IS NOT NULL AND h.tackles IS NOT NULL) AS complete
+  FROM h
+)
+SELECT c.season_id, c.player_id AS player_key, c.period::text AS period,
+  count(*)::integer AS matches,
+  sum(c.minutes_played)::integer AS minutes,
+  (count(*) FILTER (WHERE NOT c.complete))::integer AS excluded_matches,
+  coalesce(sum(c.minutes_played) FILTER (WHERE NOT c.complete), 0)::integer AS excluded_minutes,
+  sum(c.goals)::integer AS goals_sum, count(c.goals)::integer AS goals_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.goals IS NOT NULL), 0)::integer AS goals_minutes,
+  sum(c.total_shots)::integer AS shots_sum, count(c.total_shots)::integer AS shots_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.total_shots IS NOT NULL), 0)::integer AS shots_minutes,
+  sum(c.xg) AS xg_sum, count(c.xg)::integer AS xg_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.xg IS NOT NULL), 0)::integer AS xg_minutes,
+  sum(c.touches_opp_box)::integer AS touches_box_sum, count(c.touches_opp_box)::integer AS touches_box_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.touches_opp_box IS NOT NULL), 0)::integer AS touches_box_minutes,
+  sum(c.dribbles_succeeded)::integer AS dribbles_sum, count(c.dribbles_succeeded)::integer AS dribbles_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.dribbles_succeeded IS NOT NULL), 0)::integer AS dribbles_minutes,
+  sum(c.accurate_passes)::integer AS passes_sum, count(c.accurate_passes)::integer AS passes_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.accurate_passes IS NOT NULL), 0)::integer AS passes_minutes,
+  sum(c.touches)::integer AS touches_sum, count(c.touches)::integer AS touches_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.touches IS NOT NULL), 0)::integer AS touches_minutes,
+  sum(c.duels_won)::integer AS duels_won_sum, count(c.duels_won)::integer AS duels_won_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.duels_won IS NOT NULL), 0)::integer AS duels_won_minutes,
+  sum(c.tackles)::integer AS tackles_sum, count(c.tackles)::integer AS tackles_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.tackles IS NOT NULL), 0)::integer AS tackles_minutes,
+  sum(c.recoveries)::integer AS recoveries_sum, count(c.recoveries)::integer AS recoveries_count,
+  coalesce(sum(c.minutes_played) FILTER (WHERE c.recoveries IS NOT NULL), 0)::integer AS recoveries_minutes
+FROM c
+GROUP BY c.season_id, c.player_id, c.period;
+
+GRANT SELECT ON api.player_half_coverage TO vega_read;
diff --git a/backend/sql/138_sportscore_standings.sql b/backend/sql/138_sportscore_standings.sql
new file mode 100644
index 0000000000..310f88708c
--- /dev/null
+++ b/backend/sql/138_sportscore_standings.sql
@@ -0,0 +1,79 @@
+-- SportScore official standings (VI-29, docs/calculs/09-audit-2026-11/FAILURE_MODES_SPORTSCORE.md §2).
+-- One authority: an edition's official table is SportScore's current table, its rows without a
+-- stage. Rows of another provider or of a stage stay stored, are never served, and neither qualify
+-- nor disqualify it (on 18 Nov 2026 production held SportScore rows only, none with a stage).
+-- That table is served while it is qualified: it holds every club of Vega's own table, and every
+-- club's results Vega counts are still those its observation could reflect. Otherwise Vega's own
+-- table is served and the official rows stay stored with their dates.
+-- api.standings was created by 012 (generated from api_schema.py), which is immutable once applied:
+-- this file replaces the view with the same columns, so api.standing_rows (022) and every reader
+-- keep their contract.
+
+-- The results a league table counts, per club: {played, won, drawn, lost, goals for, goals
+-- against} of the edition's finished matches with both scores, of a regular or group round or of
+-- none (the matches of calculator.STANDINGS_SQL). Read by the SportScore writer and by
+-- api.standings; as its owner, since a function a view calls runs with the reader's rights.
+CREATE FUNCTION core.table_results(edition integer)
+RETURNS TABLE (team_id integer, results smallint[])
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog AS $$
+  SELECT x.team_id,
+    ARRAY[count(*), count(*) FILTER (WHERE x.gf > x.ga), count(*) FILTER (WHERE x.gf = x.ga),
+          count(*) FILTER (WHERE x.gf < x.ga), sum(x.gf), sum(x.ga)]::smallint[]
+  FROM core.matches m
+  LEFT JOIN core.rounds r ON r.id = m.round_id
+  CROSS JOIN LATERAL (VALUES (m.home_team_id, m.home_score, m.away_score),
+                             (m.away_team_id, m.away_score, m.home_score)) AS x(team_id, gf, ga)
+  WHERE m.competition_season_id = edition AND m.status = 'finished'
+    AND m.home_score IS NOT NULL AND m.away_score IS NOT NULL AND x.team_id IS NOT NULL
+    AND coalesce(r.stage, 'regular') IN ('regular', 'group')
+  GROUP BY x.team_id
+$$;
+
+-- What an observation could reflect: the club's counted results when the row was observed. NULL on
+-- the rows stored before this migration.
+ALTER TABLE core.standings_official
+  ADD COLUMN basis smallint[] CHECK (basis IS NULL OR cardinality(basis) = 6);
+
+CREATE OR REPLACE VIEW api.standings AS
+WITH authority AS NOT MATERIALIZED (
+  -- The standings authority's current table (one row per edition, group and club: the unique key
+  -- of core.standings_official). Making another provider the authority is a change of this view.
+  SELECT o.* FROM core.standings_official o WHERE o.source = 'sportscore' AND o.stage IS NULL
+), unqualified AS NOT MATERIALIZED (
+  -- Editions whose official table Vega's own table supersedes: it lacks a club of Vega's table, a
+  -- club's counted results moved since its row was observed, or (a row without a basis) a counted
+  -- match finished after its observation. Only where Vega's own table exists.
+  SELECT e.competition_season_id
+  FROM (SELECT DISTINCT o.competition_season_id FROM authority o) e
+  WHERE EXISTS (SELECT 1 FROM agg.standings a WHERE a.competition_season_id = e.competition_season_id)
+    AND EXISTS (
+      SELECT 1
+      FROM core.table_results(e.competition_season_id) c
+      FULL JOIN (SELECT o.team_id, o.basis, o.as_of FROM authority o
+                 WHERE o.competition_season_id = e.competition_season_id) o ON o.team_id = c.team_id
+      WHERE o.team_id IS NULL
+         OR (o.basis IS NOT NULL AND o.basis IS DISTINCT FROM coalesce(c.results, '{0,0,0,0,0,0}'))
+         OR (o.basis IS NULL AND EXISTS (
+               SELECT 1 FROM core.matches m LEFT JOIN core.rounds r ON r.id = m.round_id
+               WHERE m.competition_season_id = e.competition_season_id AND m.first_finished_at > o.as_of
+                 AND m.status = 'finished' AND m.home_score IS NOT NULL AND m.away_score IS NOT NULL
+                 AND coalesce(r.stage, 'regular') IN ('regular', 'group'))))
+), merged AS (
+  SELECT o.competition_season_id, o.stage, o.group_name, o.team_id, o.position, o.played, o.won, o.drawn,
+    o.lost, o.goals_for, o.goals_against, o.points, o.source::text, o.as_of
+  FROM authority o
+  WHERE NOT EXISTS (SELECT 1 FROM unqualified u WHERE u.competition_season_id = o.competition_season_id)
+  UNION ALL
+  SELECT a.competition_season_id, a.stage, a.group_name, a.team_id, a.position, a.played, a.won, a.drawn,
+    a.lost, a.goals_for, a.goals_against, a.points, 'vega', a.updated_at
+  FROM agg.standings a
+  WHERE NOT EXISTS (SELECT 1 FROM authority o WHERE o.competition_season_id = a.competition_season_id)
+     OR EXISTS (SELECT 1 FROM unqualified u WHERE u.competition_season_id = a.competition_season_id)
+)
+SELECT merged.*, api.public_id('team', merged.team_id) AS team_public_id, t.name AS team_name,
+  cr.s3_key AS crest_key, z.zone::text AS zone
+FROM merged
+JOIN core.teams t ON t.id = merged.team_id
+LEFT JOIN core.assets cr ON cr.id = t.crest_asset_id
+LEFT JOIN core.competition_zones z ON z.competition_season_id = merged.competition_season_id
+  AND merged.position BETWEEN z.position_from AND z.position_to AND merged.group_name IS NULL;
diff --git a/backend/sql/139_transfermarkt_history.sql b/backend/sql/139_transfermarkt_history.sql
new file mode 100644
index 0000000000..20c7f8971f
--- /dev/null
+++ b/backend/sql/139_transfermarkt_history.sql
@@ -0,0 +1,111 @@
+-- Transfermarkt refreshes keep what was accepted (VI-31, FAILURE_MODES.md §20). The reader updates
+-- a player's transfers by their native key and deletes none; a move the provider no longer lists
+-- keeps its facts and the first day it was missed. A contract the provider no longer names as its
+-- current one keeps its observed expiry and is set aside from the day of the change, never ended at
+-- an invented date. Nothing here changes a stored row.
+SET LOCAL lock_timeout = '3s';
+
+-- The first day an accepted history did not list the move (NULL: listed at the last accepted
+-- read). Never a cancellation: the provider does not say one.
+ALTER TABLE core.player_transfers ADD COLUMN IF NOT EXISTS absent_since date;
+-- The day from which a contract is no longer its source's current claim (NULL: it still is).
+ALTER TABLE core.player_contracts ADD COLUMN IF NOT EXISTS superseded_on date;
+
+-- One row per player and Transfermarkt transfer key. Rows without a key, and every other source,
+-- are not concerned. A base already holding a repeated key stops here with the first pair: no row
+-- is removed by choice, a person decides which one is the move.
+DO $$
+DECLARE
+  repeated integer;
+  first_pair text;
+BEGIN
+  SELECT count(*)::int, (array_agg(format('player %s, key %s, %s rows', player_id, source_key, n) ORDER BY player_id, source_key))[1]
+  INTO repeated, first_pair
+  FROM (SELECT player_id, source_key, count(*) AS n FROM core.player_transfers
+        WHERE source = 'transfermarkt' AND source_key IS NOT NULL GROUP BY 1, 2 HAVING count(*) > 1) d;
+  IF repeated > 0 THEN
+    RAISE EXCEPTION 'TRANSFER_KEYS_NOT_UNIQUE: % Transfermarkt player/key pairs hold more than one transfer (first: %); nothing was changed', repeated, first_pair;
+  END IF;
+END $$;
+CREATE UNIQUE INDEX IF NOT EXISTS player_transfers_transfermarkt_key ON core.player_transfers (player_id, source_key)
+  WHERE source = 'transfermarkt' AND source_key IS NOT NULL;
+
+-- A refresh never deletes a Transfermarkt transfer or contract. The reader before VI-31 deleted
+-- them at every read: rolled back to it, its deletions fail here and its process restarts; nothing
+-- is lost. A person's deletion says so in its transaction: SET LOCAL vega.allow_history_delete = 'on'.
+CREATE OR REPLACE FUNCTION core.keep_transfermarkt_history() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  IF OLD.source = 'transfermarkt' AND coalesce(current_setting('vega.allow_history_delete', true), '') <> 'on' THEN
+    RAISE EXCEPTION 'TRANSFERMARKT_HISTORY_KEPT: a Transfermarkt row of % (player %) is kept; an authorized deletion sets vega.allow_history_delete to on in its transaction',
+      TG_TABLE_NAME, OLD.player_id USING ERRCODE = 'restrict_violation';
+  END IF;
+  RETURN OLD;
+END $$;
+CREATE OR REPLACE TRIGGER keep_transfermarkt_history BEFORE DELETE ON core.player_transfers
+  FOR EACH ROW EXECUTE FUNCTION core.keep_transfermarkt_history();
+CREATE OR REPLACE TRIGGER keep_transfermarkt_history BEFORE DELETE ON core.player_contracts
+  FOR EACH ROW EXECUTE FUNCTION core.keep_transfermarkt_history();
+
+-- A contract is confirmed while no later claim of its source set it aside, and none of a doubted
+-- Transfermarkt link. A link is doubted when a quarantined ops.provider_links row names the player,
+-- or names the key of his current link (a merge may have moved that link to him). Same columns.
+CREATE OR REPLACE VIEW api.confirmed_player_contracts AS
+SELECT c.player_id, min(c.team_id) AS team_id, min(c.end_date) AS end_date,
+  min(c.end_season_year) AS end_season_year, min(c.end_season_competition) AS end_season_competition
+FROM core.player_contracts c
+WHERE c.as_of <= current_date AND c.start_date <= current_date
+  AND CASE WHEN c.end_date IS NOT NULL THEN c.end_date >= current_date
+           WHEN c.end_season_year IS NOT NULL THEN c.end_season_year >= extract(year FROM current_date)
+           ELSE true END
+  AND (c.superseded_on IS NULL OR c.superseded_on > current_date)
+  AND NOT (c.source = 'transfermarkt' AND EXISTS (
+    SELECT 1 FROM ops.provider_links d
+    WHERE d.entity_type = 'player' AND d.provider = 'transfermarkt' AND d.quarantined_at IS NOT NULL
+      AND (d.entity_id = c.player_id OR d.provider_key IN (
+        SELECT i.provider_key FROM core.provider_ids i
+        WHERE i.entity_type = 'player' AND i.provider = 'transfermarkt' AND i.entity_id = c.player_id AND i.is_current))))
+GROUP BY c.player_id
+HAVING count(DISTINCT c.team_id) = 1
+  AND count(DISTINCT (c.end_date, c.end_season_year, c.end_season_competition)) = 1
+  AND bool_and(c.end_date IS NOT NULL OR c.end_season_year IS NOT NULL);
+
+-- The profile (114) with the same doubt: by the player, or by the key of his current link.
+CREATE OR REPLACE VIEW api.player_profiles AS
+SELECT p.id AS player_id, api.public_id('player', p.id) AS public_id, p.name, p.short_name, p.position_id, p.country_code,
+  p.shirt_number, ph.source_url AS image_url, p.birth_date::text AS birth_date, p.height_cm,
+  p.preferred_foot::text AS preferred_foot, contract.end_date::text AS contract_until,
+  t.name AS contract_team,
+  coalesce(live.contract_until, observed.contract_until)::text AS observed_contract_until,
+  CASE WHEN live.contract_until IS NOT NULL THEN coalesce(live_team.name, live_club.name) ELSE observed.club_name END AS observed_contract_team,
+  CASE WHEN live.contract_until IS NOT NULL THEN live.read_on ELSE observed.observed_on END::text AS observed_contract_on,
+  contract.end_season_year AS contract_until_season,
+  contract.end_season_competition AS contract_season_competition,
+  market.value_eur AS market_value_eur, market.valued_at::text AS market_value_updated_at
+FROM core.players p
+LEFT JOIN core.assets ph ON ph.id = p.photo_asset_id
+LEFT JOIN api.confirmed_player_contracts contract ON contract.player_id = p.id
+LEFT JOIN core.teams t ON t.id = contract.team_id
+LEFT JOIN LATERAL (
+  SELECT true AS doubted FROM ops.provider_links d WHERE d.entity_type = 'player' AND d.provider = 'transfermarkt'
+    AND d.quarantined_at IS NOT NULL
+    AND (d.entity_id = p.id OR d.provider_key IN (
+      SELECT i.provider_key FROM core.provider_ids i
+      WHERE i.entity_type = 'player' AND i.provider = 'transfermarkt' AND i.entity_id = p.id AND i.is_current))
+  LIMIT 1
+) doubt ON true
+LEFT JOIN core.player_fact_observations observed
+  ON observed.player_id = p.id AND observed.source = 'transfermarkt_snapshot' AND doubt.doubted IS NULL
+  AND observed.contract_until IS NOT NULL AND observed.club_name IS NOT NULL
+  AND (observed.birth_date IS NULL OR observed.birth_date = p.birth_date)
+LEFT JOIN core.provider_ids link ON link.entity_type = 'player' AND link.provider = 'transfermarkt'
+  AND link.entity_id = p.id AND link.is_current AND doubt.doubted IS NULL
+LEFT JOIN core.provider_players live ON live.provider = 'transfermarkt' AND live.provider_key = link.provider_key
+  AND live.contract_until >= current_date
+LEFT JOIN core.provider_ids club_link ON club_link.entity_type = 'team' AND club_link.provider = 'transfermarkt'
+  AND club_link.provider_key = live.provider_club AND club_link.is_current
+LEFT JOIN core.teams live_team ON live_team.id = club_link.entity_id
+LEFT JOIN core.provider_clubs live_club ON live_club.provider = 'transfermarkt' AND live_club.provider_key = live.provider_club
+LEFT JOIN LATERAL (
+  SELECT v.value_eur, v.valued_at FROM api.player_market_values v
+  WHERE v.player_id = p.id ORDER BY v.valued_at DESC LIMIT 1
+) market ON true;
diff --git a/backend/sql/140_archive_apply_decisions.sql b/backend/sql/140_archive_apply_decisions.sql
new file mode 100644
index 0000000000..d67104d1ec
--- /dev/null
+++ b/backend/sql/140_archive_apply_decisions.sql
@@ -0,0 +1,51 @@
+-- Archive applies, durable and serialized (VI-27, docs/calculs/09-audit-2026-11/FAILURE_MODES.md §23). 136 to 139 are
+-- reserved by the other audit tracks; 134 is kept as applied on the rehearsal clones.
+--
+-- 1. ops.archive_plan_seasons: each season's decision under a stored plan, written in the transaction that applies it
+--    (or alone, for a drift or a refusal): a run resumes after a crash, a subset never stamps the others.
+-- 2. ops.archive_lock_match_references(): the SHARE locks an archive deletion takes, until its commit, on every relation
+--    naming a match without a foreign key to it (no writer can add a reference between its last check and its commit).
+--    It runs as its owner: vega_collect gains no table privilege. Writers with a foreign key wait on the match row lock.
+SET LOCAL lock_timeout = '3s';
+
+CREATE TABLE ops.archive_plan_seasons (
+  sha256 text NOT NULL REFERENCES ops.archive_plans(sha256),
+  label text NOT NULL CHECK (label ~ '^[0-9]{4}/[0-9]{4}$'),
+  outcome text NOT NULL CHECK (outcome IN ('applied', 'partial', 'drift', 'refused')),
+  decided_at timestamptz NOT NULL DEFAULT now(),
+  receipt jsonb NOT NULL,
+  PRIMARY KEY (sha256, label)
+);
+COMMENT ON TABLE ops.archive_plan_seasons IS
+  'One decision per season of a stored archive plan, committed with the season it applies (VI-27, FAILURE_MODES.md §23).';
+REVOKE ALL ON ops.archive_plan_seasons FROM PUBLIC;
+GRANT SELECT, INSERT ON ops.archive_plan_seasons TO vega_collect;
+REVOKE UPDATE, DELETE, TRUNCATE ON ops.archive_plan_seasons FROM vega_collect;
+
+CREATE FUNCTION ops.archive_lock_match_references()
+RETURNS text[] LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+DECLARE
+  ref record;
+  locked text[] := '{}';
+BEGIN
+  FOR ref IN
+    SELECT DISTINCT n.nspname AS schema_name, c.relname AS table_name
+    FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+    WHERE n.nspname IN ('core', 'agg', 'ops') AND c.relkind IN ('r', 'p') AND NOT c.relispartition
+      AND (EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attnum > 0 AND NOT a.attisdropped
+                     AND a.atttypid IN ('integer'::regtype, 'bigint'::regtype)
+                     AND (a.attname = 'match_id' OR a.attname LIKE '%\_match\_id' ESCAPE '\')
+                     AND NOT EXISTS (SELECT 1 FROM pg_constraint k WHERE k.conrelid = c.oid AND k.contype = 'f'
+                                       AND k.confrelid = 'core.matches'::regclass AND a.attnum = ANY(k.conkey)))
+           OR (EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attname = 'entity_type' AND NOT a.attisdropped)
+               AND EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attname = 'entity_id' AND NOT a.attisdropped))
+           OR (n.nspname = 'ops' AND c.relname = 'resource_versions'))
+    ORDER BY 1, 2
+  LOOP
+    EXECUTE format('LOCK TABLE %I.%I IN SHARE MODE', ref.schema_name, ref.table_name);
+    locked := locked || (ref.schema_name || '.' || ref.table_name);
+  END LOOP;
+  RETURN locked;
+END $$;
+REVOKE ALL ON FUNCTION ops.archive_lock_match_references() FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION ops.archive_lock_match_references() TO vega_collect;
diff --git a/backend/sql/141_archive_removal_guards.sql b/backend/sql/141_archive_removal_guards.sql
new file mode 100644
index 0000000000..3f7c1c7bd1
--- /dev/null
+++ b/backend/sql/141_archive_removal_guards.sql
@@ -0,0 +1,147 @@
+-- Archive removals that stay safe after their commit, and the edition emblem column (VI-27,
+-- docs/calculs/09-audit-2026-11/FAILURE_MODES.md §24; 141 is T4's reservation, 134 and 140 stay as applied).
+--
+-- 1. core.competition_seasons.emblem_asset_id: an edition's own emblem, distinct from its family's logo (the joint
+--    edition-emblem arbitration of 18 Nov: storage and writer T4, reader T7). An edition with one is never removed.
+-- 2. ops.archive_removals: the tombstone of every archive match, edition or round a reviewed plan deleted, written in the
+--    deleting transaction and never removed.
+-- 3. ops.reject_removed_archive_reference(): on every relation naming a match or an edition without a foreign key, an
+--    insert or update naming a tombstoned id fails with foreign_key_violation. A writer blocked by the deletion's SHARE
+--    locks resumes after the commit and is refused; so is one starting later. Writers with a foreign key fail on the row.
+-- 4. ops.archive_edition_dependents(): what references an edition or its rounds, with or without a foreign key.
+-- 5. ops.archive_lock_references(): the SHARE locks of a deletion, on every relation naming a match or an edition
+--    without a foreign key. The functions run as their owner: vega_collect gains no table privilege.
+SET LOCAL lock_timeout = '3s';
+
+ALTER TABLE core.competition_seasons ADD COLUMN emblem_asset_id integer REFERENCES core.assets(id);
+COMMENT ON COLUMN core.competition_seasons.emblem_asset_id IS
+  'The edition''s own emblem (role edition_emblem), never the family logo copied; NULL when none is attested (VI-27).';
+
+CREATE TABLE ops.archive_removals (
+  kind text NOT NULL CHECK (kind IN ('match', 'edition', 'round')),
+  id integer NOT NULL,
+  season_id integer NOT NULL,
+  archive_key text,
+  plan_sha256 text CHECK (plan_sha256 IS NULL OR plan_sha256 ~ '^[0-9a-f]{64}$'),
+  removed_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (kind, id)
+);
+COMMENT ON TABLE ops.archive_removals IS
+  'Archive rows a reviewed plan deleted; a reference to one is refused (FAILURE_MODES.md §24).';
+REVOKE ALL ON ops.archive_removals FROM PUBLIC;
+GRANT SELECT, INSERT ON ops.archive_removals TO vega_collect;
+REVOKE UPDATE, DELETE, TRUNCATE ON ops.archive_removals FROM vega_collect;
+
+CREATE FUNCTION ops.reject_removed_archive_reference()
+RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+DECLARE
+  fields jsonb := to_jsonb(NEW);
+  wanted text := TG_ARGV[0];
+  ref text := fields ->> TG_ARGV[1];
+BEGIN
+  IF ref IS NOT NULL AND EXISTS (SELECT 1 FROM ops.archive_removals r WHERE r.kind = wanted AND r.id = ref::bigint) THEN
+    RAISE EXCEPTION USING ERRCODE = 'foreign_key_violation',
+      MESSAGE = format('%s.%s.%s names archive %s %s, removed by a reviewed plan', TG_TABLE_SCHEMA, TG_TABLE_NAME, TG_ARGV[1], wanted, ref);
+  END IF;
+  RETURN NEW;
+END $$;
+REVOKE ALL ON FUNCTION ops.reject_removed_archive_reference() FROM PUBLIC;
+
+DO $$
+DECLARE
+  ref record;
+BEGIN
+  -- Columns naming a match or an edition without a foreign key to it.
+  FOR ref IN
+    SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name,
+           CASE WHEN a.attname LIKE '%competition\_season\_id' ESCAPE '\' THEN 'edition' ELSE 'match' END AS kind
+    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid JOIN pg_namespace n ON n.oid = c.relnamespace
+    WHERE n.nspname IN ('core', 'agg', 'ops') AND c.relkind IN ('r', 'p') AND NOT c.relispartition
+      AND a.attnum > 0 AND NOT a.attisdropped AND a.atttypid IN ('integer'::regtype, 'bigint'::regtype)
+      AND ((a.attname = 'match_id' OR a.attname LIKE '%\_match\_id' ESCAPE '\')
+           AND NOT EXISTS (SELECT 1 FROM pg_constraint k WHERE k.conrelid = c.oid AND k.contype = 'f'
+                             AND k.confrelid = 'core.matches'::regclass AND a.attnum = ANY(k.conkey))
+        OR (a.attname = 'competition_season_id' OR a.attname LIKE '%\_competition\_season\_id' ESCAPE '\')
+           AND NOT EXISTS (SELECT 1 FROM pg_constraint k WHERE k.conrelid = c.oid AND k.contype = 'f'
+                             AND k.confrelid = 'core.competition_seasons'::regclass AND a.attnum = ANY(k.conkey)))
+    ORDER BY 1, 2, 3
+  LOOP
+    EXECUTE format('CREATE TRIGGER %I BEFORE INSERT OR UPDATE OF %I ON %I.%I FOR EACH ROW WHEN (NEW.%I IS NOT NULL) '
+                   'EXECUTE FUNCTION ops.reject_removed_archive_reference(%L, %L)',
+                   'archive_removed_' || ref.column_name, ref.column_name, ref.schema_name, ref.table_name, ref.column_name,
+                   ref.kind, ref.column_name);
+  END LOOP;
+  -- (entity_type, entity_id) references to a match.
+  FOR ref IN
+    SELECT n.nspname AS schema_name, c.relname AS table_name
+    FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+    WHERE n.nspname IN ('core', 'agg', 'ops') AND c.relkind IN ('r', 'p') AND NOT c.relispartition
+      AND EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attname = 'entity_type' AND NOT a.attisdropped)
+      AND EXISTS (SELECT 1 FROM pg_attribute a WHERE a.attrelid = c.oid AND a.attname = 'entity_id' AND NOT a.attisdropped)
+    ORDER BY 1, 2
+  LOOP
+    EXECUTE format('CREATE TRIGGER archive_removed_entity_id BEFORE INSERT OR UPDATE OF entity_type, entity_id ON %I.%I FOR EACH ROW '
+                   'WHEN (NEW.entity_type::text = ''match'') EXECUTE FUNCTION ops.reject_removed_archive_reference(''match'', ''entity_id'')',
+                   ref.schema_name, ref.table_name);
+  END LOOP;
+END $$;
+
+CREATE TRIGGER archive_removed_match_version BEFORE INSERT OR UPDATE OF resource_kind, resource_id ON ops.resource_versions FOR EACH ROW
+  WHEN (NEW.resource_kind::text = 'match') EXECUTE FUNCTION ops.reject_removed_archive_reference('match', 'resource_id');
+CREATE TRIGGER archive_removed_edition_version BEFORE INSERT OR UPDATE OF resource_kind, resource_id ON ops.resource_versions FOR EACH ROW
+  WHEN (NEW.resource_kind::text = 'competition_season') EXECUTE FUNCTION ops.reject_removed_archive_reference('edition', 'resource_id');
+
+CREATE FUNCTION ops.archive_edition_dependents(edition_ids integer[], round_ids integer[])
+RETURNS TABLE(kind text, id integer, dependency text)
+LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+DECLARE
+  ref record;
+BEGIN
+  IF cardinality(coalesce(edition_ids, '{}')) > 5000 OR cardinality(coalesce(round_ids, '{}')) > 5000 THEN
+    RAISE EXCEPTION 'archive_edition_dependents takes at most 5000 ids of each kind';
+  END IF;
+  -- Every column naming an edition or a round, with or without a foreign key; core.matches is the caller's (it binds
+  -- the matches it removes) and core.rounds names its own edition.
+  FOR ref IN
+    SELECT n.nspname AS schema_name, c.relname AS table_name, a.attname AS column_name,
+           CASE WHEN a.attname LIKE '%round\_id' ESCAPE '\' THEN 'round' ELSE 'edition' END AS kind
+    FROM pg_attribute a JOIN pg_class c ON c.oid = a.attrelid JOIN pg_namespace n ON n.oid = c.relnamespace
+    WHERE n.nspname IN ('core', 'agg', 'ops') AND c.relkind IN ('r', 'p') AND NOT c.relispartition
+      AND a.attnum > 0 AND NOT a.attisdropped AND a.atttypid IN ('integer'::regtype, 'bigint'::regtype)
+      AND (a.attname = 'competition_season_id' OR a.attname LIKE '%\_competition\_season\_id' ESCAPE '\'
+           OR a.attname = 'round_id' OR a.attname LIKE '%\_round\_id' ESCAPE '\')
+      AND NOT (n.nspname = 'core' AND c.relname = 'matches')
+      AND NOT (n.nspname = 'core' AND c.relname = 'rounds' AND a.attname = 'competition_season_id')
+    ORDER BY 1, 2, 3
+  LOOP
+    RETURN QUERY EXECUTE format('SELECT DISTINCT %L::text, t.%I::integer, %L::text FROM %I.%I t WHERE t.%I = ANY($1)',
+      ref.kind, ref.column_name, ref.schema_name || '.' || ref.table_name || '.' || ref.column_name,
+      ref.schema_name, ref.table_name, ref.column_name)
+      USING CASE WHEN ref.kind = 'round' THEN round_ids ELSE edition_ids END;
+  END LOOP;
+  RETURN QUERY SELECT 'edition'::text, v.resource_id::integer, 'ops.resource_versions.resource_id'::text FROM ops.resource_versions v
+    WHERE v.resource_kind::text = 'competition_season' AND v.resource_id = ANY(edition_ids);
+  RETURN QUERY SELECT 'edition'::text, cs.id, 'core.competition_seasons.emblem_asset_id'::text FROM core.competition_seasons cs
+    WHERE cs.id = ANY(edition_ids) AND cs.emblem_asset_id IS NOT NULL;
+END $$;
+REVOKE ALL ON FUNCTION ops.archive_edition_dependents(integer[], integer[]) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION ops.archive_edition_dependents(integer[], integer[]) TO vega_collect;
+
+CREATE FUNCTION ops.archive_lock_references()
+RETURNS text[] LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+DECLARE
+  ref record;
+  locked text[] := '{}';
+BEGIN
+  FOR ref IN
+    SELECT DISTINCT tgrelid::regclass::text AS relation FROM pg_trigger
+    WHERE tgname LIKE 'archive\_removed\_%' ESCAPE '\' AND NOT tgisinternal AND tgparentid = 0
+    ORDER BY 1
+  LOOP
+    EXECUTE format('LOCK TABLE %s IN SHARE MODE', ref.relation);
+    locked := locked || ref.relation;
+  END LOOP;
+  RETURN locked;
+END $$;
+REVOKE ALL ON FUNCTION ops.archive_lock_references() FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION ops.archive_lock_references() TO vega_collect;
diff --git a/backend/sql/142_edition_artwork_provenance.sql b/backend/sql/142_edition_artwork_provenance.sql
new file mode 100644
index 0000000000..28a79b734f
--- /dev/null
+++ b/backend/sql/142_edition_artwork_provenance.sql
@@ -0,0 +1,12 @@
+-- 141 introduced the pointer and its archive deletion guard. The approved pack
+-- records attribution per edition even where two editions share an asset.
+SET LOCAL lock_timeout = '3s';
+CREATE TABLE core.edition_artwork_provenance (
+    competition_season_id integer PRIMARY KEY REFERENCES core.competition_seasons(id),
+    asset_id integer NOT NULL REFERENCES core.assets(id),
+    manifest_sha256 text NOT NULL CHECK (manifest_sha256 ~ '^[0-9a-f]{64}$'),
+    certificate jsonb NOT NULL CHECK (certificate ->> 'asset_role' = 'edition_emblem'),
+    linked_at timestamptz NOT NULL DEFAULT now()
+);
+REVOKE ALL ON core.edition_artwork_provenance FROM PUBLIC, vega_collect, vega_read;
+GRANT SELECT, INSERT ON core.edition_artwork_provenance TO vega_collect;
diff --git a/backend/sql/143_archive_match_attestations.sql b/backend/sql/143_archive_match_attestations.sql
new file mode 100644
index 0000000000..e13b9939a9
--- /dev/null
+++ b/backend/sql/143_archive_match_attestations.sql
@@ -0,0 +1,66 @@
+-- Exact archive fixture decisions and persisted public aliases (VI-27).
+SET LOCAL lock_timeout = '3s';
+CREATE TABLE core.archive_match_attestations (
+    season_id smallint NOT NULL,
+    match_id integer NOT NULL,
+    canonical_key text NOT NULL CHECK (canonical_key LIKE 'r:%'),
+    former_key text CHECK (former_key LIKE 'g:%'),
+    former_id integer UNIQUE,
+    canonical_date date NOT NULL,
+    authority_key text NOT NULL UNIQUE,
+    proof_sha256 text NOT NULL CHECK (proof_sha256 ~ '^[0-9a-f]{64}$'),
+    proof jsonb NOT NULL,
+    PRIMARY KEY (season_id, canonical_key),
+    UNIQUE (season_id, former_key),
+    UNIQUE (match_id, season_id),
+    FOREIGN KEY (match_id, season_id) REFERENCES core.matches(id, season_id),
+    CHECK (former_id IS NULL OR (former_key IS NOT NULL AND former_id <> match_id))
+);
+REVOKE ALL ON core.archive_match_attestations FROM PUBLIC, vega_collect, vega_read;
+GRANT SELECT, INSERT ON core.archive_match_attestations TO vega_collect;
+
+CREATE FUNCTION core.protect_attested_archive_match() RETURNS trigger
+LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+BEGIN
+    IF NEW.season_id NOT BETWEEN 1963 AND 1966 THEN
+        RETURN NEW;
+    END IF;
+    IF NEW.archive_key IS NULL AND (TG_OP = 'INSERT' OR OLD.archive_key IS NULL) THEN
+        RETURN NEW;
+    END IF;
+    -- A legacy INSERT that starts during the transfer must check after the
+    -- reviewed transaction commits. The key check alone would race the unique index.
+    PERFORM pg_advisory_xact_lock(hashtext('vega.archives.apply'));
+    IF EXISTS(
+        SELECT 1 FROM core.archive_match_attestations a
+        WHERE a.season_id=NEW.season_id AND
+          (a.former_key=NEW.archive_key OR
+           (a.match_id=NEW.id AND (a.canonical_key IS DISTINCT FROM NEW.archive_key OR a.canonical_date IS DISTINCT FROM NEW.match_date)))
+    ) THEN
+        RAISE foreign_key_violation USING MESSAGE = 'archive match key or date has an attested replacement';
+    END IF;
+    RETURN NEW;
+END $$;
+REVOKE ALL ON FUNCTION core.protect_attested_archive_match() FROM PUBLIC;
+CREATE TRIGGER protect_attested_archive_match BEFORE INSERT OR UPDATE OF archive_key,match_date ON core.matches
+FOR EACH ROW EXECUTE FUNCTION core.protect_attested_archive_match();
+
+CREATE FUNCTION core.protect_attested_archive_goals() RETURNS trigger
+LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+BEGIN
+    IF EXISTS(SELECT 1 FROM core.archive_match_attestations a WHERE a.season_id=OLD.season_id AND a.match_id=OLD.match_id
+              AND a.former_key IS NOT NULL) THEN
+        RAISE foreign_key_violation USING MESSAGE = 'reviewed archive goal transfers cannot be removed by a source replay';
+    END IF;
+    RETURN OLD;
+END $$;
+REVOKE ALL ON FUNCTION core.protect_attested_archive_goals() FROM PUBLIC;
+CREATE TRIGGER protect_attested_archive_goals BEFORE DELETE ON core.match_events
+FOR EACH ROW WHEN (OLD.event_type='goal') EXECUTE FUNCTION core.protect_attested_archive_goals();
+
+CREATE VIEW api.archive_match_aliases AS
+SELECT season_id, match_id, canonical_key, former_key,
+       CASE WHEN former_id IS NOT NULL THEN 'm_v' || lpad(former_id::text, 7, '0') END AS former_public_id,
+       proof #>> '{goals_observation,team1}' AS former_home, proof #>> '{goals_observation,team2}' AS former_away
+FROM core.archive_match_attestations WHERE former_key IS NOT NULL;
+GRANT SELECT ON api.archive_match_aliases TO vega_read;
diff --git a/backend/sql/144_edition_artwork_reads.sql b/backend/sql/144_edition_artwork_reads.sql
new file mode 100644
index 0000000000..e21e356835
--- /dev/null
+++ b/backend/sql/144_edition_artwork_reads.sql
@@ -0,0 +1,94 @@
+-- Read the verified emblem of the exact edition selected by each existing view.
+-- The storage and link validation are owned by the archive migrations (141/142).
+-- Keep family logos, established columns, views' row sets and reader grants.
+SET LOCAL lock_timeout = '3s';
+
+CREATE OR REPLACE VIEW api.cup_editions AS
+SELECT cs.id AS competition_season_id, split_part(cs.cup_key, ':', 1) AS kind, split_part(cs.cup_key, ':', 2) AS competition,
+  cs.native_label AS season, cs.cup_name AS name, cs.cup_source_url AS source_url, cs.cup_data_url AS data_url,
+  cs.cup_checked_at AS checked_at, cs.cup_updated_at AS updated_at,
+  api.public_id('competition', cs.competition_id) AS competition_id,
+  CASE split_part(cs.cup_key, ':', 1) WHEN 'open-cups' THEN 'matches-v1' WHEN 'openligadb' THEN 'rounds-v1'
+    WHEN 'open-matchday' THEN 'table-v1' ELSE 'results-v1' END AS format,
+  cs.competition_id AS internal_competition_id,
+  la.source_url AS logo_url, emblem.source_url AS edition_emblem_url
+FROM core.competition_seasons cs
+LEFT JOIN core.competitions c ON c.id = cs.competition_id
+LEFT JOIN core.assets la ON la.id = c.logo_asset_id
+LEFT JOIN core.assets emblem ON emblem.id = cs.emblem_asset_id
+WHERE cs.cup_key IS NOT NULL;
+
+CREATE OR REPLACE VIEW api.fixtures AS
+SELECT m.id AS match_id, m.season_id, m.competition_season_id, m.revision,
+  coalesce(mk.provider_key, 'm_v' || lpad(m.id::text, 7, '0')) AS id,
+  se.label AS season, cs.native_label AS native_season, m.match_date AS day, m.kickoff_at,
+  to_char(m.kickoff_at AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"') AS time_utc,
+  m.status::text AS status, r.name AS round_name, m.has_playoff,
+  m.home_team_id AS home_internal_id,
+  coalesce(hk.provider_key, 't_v' || lpad(m.home_team_id::text, 7, '0')) AS home_team_id,
+  ht.name AS home_name, hc.source_url AS home_image_url,
+  m.away_team_id AS away_internal_id,
+  coalesce(ak.provider_key, 't_v' || lpad(m.away_team_id::text, 7, '0')) AS away_team_id,
+  awt.name AS away_name, ac.source_url AS away_image_url,
+  coalesce(ck.provider_key, 'l_v' || lpad(cs.competition_id::text, 7, '0')) AS league_id,
+  c.name AS league_name, lg.source_url AS league_image_url, c.country_code AS country,
+  m.home_score::float8 AS score_home, m.away_score::float8 AS score_away,
+  m.home_penalty_score::float8 AS score_penalty_home, m.away_penalty_score::float8 AS score_penalty_away,
+  ref.id AS referee_internal_id, ref.name AS referee, v.id AS venue_internal_id, v.name AS stadium,
+  emblem.source_url AS edition_emblem_url
+FROM core.matches m
+JOIN core.seasons se ON se.id = m.season_id
+JOIN core.competition_seasons cs ON cs.id = m.competition_season_id AND cs.archive_key IS NULL AND cs.cup_key IS NULL
+JOIN core.competitions c ON c.id = cs.competition_id
+LEFT JOIN core.rounds r ON r.id = m.round_id
+LEFT JOIN core.teams ht ON ht.id = m.home_team_id
+LEFT JOIN core.teams awt ON awt.id = m.away_team_id
+LEFT JOIN core.assets hc ON hc.id = ht.crest_asset_id
+LEFT JOIN core.assets ac ON ac.id = awt.crest_asset_id
+LEFT JOIN core.assets lg ON lg.id = c.logo_asset_id
+LEFT JOIN core.assets emblem ON emblem.id = cs.emblem_asset_id
+LEFT JOIN core.referees ref ON ref.id = m.referee_id
+LEFT JOIN core.venues v ON v.id = m.venue_id
+LEFT JOIN core.provider_ids mk ON mk.entity_type = 'match' AND mk.entity_id = m.id AND mk.provider = 'pitchapi' AND mk.is_current
+LEFT JOIN core.provider_ids hk ON hk.entity_type = 'team' AND hk.entity_id = m.home_team_id AND hk.provider = 'pitchapi' AND hk.is_current
+LEFT JOIN core.provider_ids ak ON ak.entity_type = 'team' AND ak.entity_id = m.away_team_id AND ak.provider = 'pitchapi' AND ak.is_current
+LEFT JOIN core.provider_ids ck ON ck.entity_type = 'competition' AND ck.entity_id = cs.competition_id AND ck.provider = 'pitchapi' AND ck.is_current;
+
+CREATE OR REPLACE VIEW api.archive_editions AS
+SELECT cs.id AS competition_season_id, se.label AS season, cs.archive_key AS id, cs.archive_name AS name,
+  cs.archive_country AS country, cs.archive_position AS position, emblem.source_url AS edition_emblem_url
+FROM core.competition_seasons cs JOIN core.seasons se ON se.id = cs.season_id
+LEFT JOIN core.assets emblem ON emblem.id = cs.emblem_asset_id
+WHERE cs.archive_key IS NOT NULL;
+
+-- The match's own club sides also travel with its non-tabular cup representation.
+CREATE OR REPLACE VIEW api.cup_matches AS
+SELECT m.competition_season_id, m.id AS match_id, m.archive_position AS position, k.provider_key AS key, m.source::text AS provider,
+  m.match_date AS date, m.status::text AS status, r.name AS round, m.group_name, m.match_number,
+  coalesce(m.home_team_name, ht.name) AS home, hk.provider_key AS home_key,
+  coalesce(m.away_team_name, awt.name) AS away, ak.provider_key AS away_key,
+  m.home_score, m.away_score, m.home_score_90, m.away_score_90, m.home_score_ht, m.away_score_ht,
+  m.home_score_et, m.away_score_et, m.home_penalty_score, m.away_penalty_score,
+  m.is_neutral,
+  api.public_id('team', home_kept.id) AS home_team_public_id, home_crest.source_url AS home_image_url,
+  api.public_id('team', away_kept.id) AS away_team_public_id, away_crest.source_url AS away_image_url
+FROM core.matches m
+JOIN core.competition_seasons cs ON cs.id = m.competition_season_id AND cs.cup_key IS NOT NULL
+LEFT JOIN core.provider_ids k ON k.entity_type = 'match' AND k.entity_id = m.id AND k.provider = m.source
+LEFT JOIN core.rounds r ON r.id = m.round_id
+LEFT JOIN core.teams ht ON ht.id = m.home_team_id
+LEFT JOIN core.teams awt ON awt.id = m.away_team_id
+LEFT JOIN core.teams home_kept ON home_kept.id = coalesce(ht.merged_into, ht.id)
+LEFT JOIN core.assets home_crest ON home_crest.id = home_kept.crest_asset_id
+LEFT JOIN core.teams away_kept ON away_kept.id = coalesce(awt.merged_into, awt.id)
+LEFT JOIN core.assets away_crest ON away_crest.id = away_kept.crest_asset_id
+LEFT JOIN LATERAL (
+  SELECT p.provider_key FROM core.provider_ids p
+  WHERE p.entity_type = 'team' AND p.entity_id = m.home_team_id AND p.provider = m.source
+  ORDER BY (p.provider_key = 'name:' || m.home_team_name) DESC NULLS LAST, p.is_current DESC, p.provider_key LIMIT 1
+) hk ON true
+LEFT JOIN LATERAL (
+  SELECT p.provider_key FROM core.provider_ids p
+  WHERE p.entity_type = 'team' AND p.entity_id = m.away_team_id AND p.provider = m.source
+  ORDER BY (p.provider_key = 'name:' || m.away_team_name) DESC NULLS LAST, p.is_current DESC, p.provider_key LIMIT 1
+) ak ON true;
diff --git a/backend/sql/145_dfb_period_observations.sql b/backend/sql/145_dfb_period_observations.sql
new file mode 100644
index 0000000000..f0b6198807
--- /dev/null
+++ b/backend/sql/145_dfb_period_observations.sql
@@ -0,0 +1,16 @@
+-- Scoped phase source receipts (VI-27). Match publication keeps its existing typed columns.
+CREATE TABLE ops.dfb_period_observations (
+  scope text NOT NULL CHECK (scope IN ('openligadb:germany-cup:2025/2026', 'openligadb:germany-cup:2026/2027')),
+  source_sha256 text NOT NULL CHECK (source_sha256 ~ '^[0-9a-f]{64}$'),
+  ledger_sha256 text NOT NULL CHECK (ledger_sha256 ~ '^[0-9a-f]{64}$'),
+  status text NOT NULL CHECK (status IN ('accepted', 'refused')),
+  code text NOT NULL,
+  observed_at timestamptz NOT NULL,
+  observation jsonb NOT NULL,
+  detail text,
+  PRIMARY KEY (scope, source_sha256, ledger_sha256, status, code)
+);
+REVOKE ALL ON ops.dfb_period_observations FROM PUBLIC, vega_collect, vega_read;
+GRANT INSERT ON ops.dfb_period_observations TO vega_collect;
+COMMENT ON TABLE ops.dfb_period_observations IS
+  'Native DFB-Pokal phase observations and their acceptance or refusal, bound to source bytes and the applied DFB ledger.';
diff --git a/backend/sql/146_world_cup_family_artwork.sql b/backend/sql/146_world_cup_family_artwork.sql
new file mode 100644
index 0000000000..af46d33cea
--- /dev/null
+++ b/backend/sql/146_world_cup_family_artwork.sql
@@ -0,0 +1,81 @@
+-- The two World Cup family media bindings require specific family artwork provenance (VI-27).
+SET LOCAL lock_timeout = '3s';
+
+CREATE TABLE core.family_artwork_qualifications (
+    competition_id integer NOT NULL REFERENCES core.competitions(id),
+    asset_id integer NOT NULL REFERENCES core.assets(id),
+    certificate jsonb NOT NULL CHECK (certificate ->> 'asset_role' = 'competition_logo' AND certificate ->> 'competition_identity_only' = 'true'),
+    manifest_sha256 text NOT NULL CHECK (manifest_sha256 ~ '^[0-9a-f]{64}$'),
+    PRIMARY KEY (competition_id, asset_id)
+);
+REVOKE ALL ON core.family_artwork_qualifications FROM PUBLIC, vega_collect, vega_read;
+GRANT SELECT, INSERT ON core.family_artwork_qualifications TO vega_collect;
+
+CREATE FUNCTION core.family_artwork_requires_proof(competition integer) RETURNS boolean
+LANGUAGE sql STABLE SET search_path = pg_catalog, pg_temp AS $$
+    SELECT EXISTS(
+        SELECT 1 FROM core.provider_ids
+        WHERE entity_type='competition' AND entity_id=competition AND
+          ((provider='vega' AND provider_key='cup:open-cups:world-cup-history') OR
+           (provider='pitchapi' AND provider_key='l_1XLtP0'))
+    )
+$$;
+REVOKE ALL ON FUNCTION core.family_artwork_requires_proof(integer) FROM PUBLIC;
+GRANT EXECUTE ON FUNCTION core.family_artwork_requires_proof(integer) TO vega_collect;
+
+-- Keep a previously accepted family logo and let the rest of an old writer's update proceed.
+CREATE FUNCTION core.require_family_artwork_proof() RETURNS trigger
+LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+BEGIN
+    IF NEW.logo_asset_id IS NOT NULL AND NEW.logo_asset_id IS DISTINCT FROM OLD.logo_asset_id
+       AND core.family_artwork_requires_proof(NEW.id)
+       AND NOT EXISTS (SELECT 1 FROM core.family_artwork_qualifications q
+                       WHERE q.competition_id=NEW.id AND q.asset_id=NEW.logo_asset_id) THEN
+        NEW.logo_asset_id := OLD.logo_asset_id;
+    END IF;
+    RETURN NEW;
+END
+$$;
+REVOKE ALL ON FUNCTION core.require_family_artwork_proof() FROM PUBLIC;
+CREATE TRIGGER preserve_scope_of_world_cup_artwork BEFORE UPDATE OF logo_asset_id ON core.competitions
+FOR EACH ROW EXECUTE FUNCTION core.require_family_artwork_proof();
+
+-- Store.entity initially inserts the image before it creates the PitchAPI provider binding.
+CREATE FUNCTION core.check_new_world_cup_artwork_binding() RETURNS trigger
+LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+BEGIN
+    UPDATE core.competitions c SET logo_asset_id=NULL
+    WHERE c.id=NEW.entity_id AND c.logo_asset_id IS NOT NULL
+      AND NOT EXISTS (SELECT 1 FROM core.family_artwork_qualifications q
+                      WHERE q.competition_id=c.id AND q.asset_id=c.logo_asset_id);
+    RETURN NEW;
+END
+$$;
+REVOKE ALL ON FUNCTION core.check_new_world_cup_artwork_binding() FROM PUBLIC;
+CREATE TRIGGER check_new_world_cup_artwork_binding AFTER INSERT ON core.provider_ids
+FOR EACH ROW WHEN (NEW.entity_type='competition' AND
+    ((NEW.provider='vega' AND NEW.provider_key='cup:open-cups:world-cup-history') OR
+     (NEW.provider='pitchapi' AND NEW.provider_key='l_1XLtP0')))
+EXECUTE FUNCTION core.check_new_world_cup_artwork_binding();
+
+-- Exact RDS family + source URL + image digest observations from the 18 November audit.
+WITH confirmed(provider, key, family, url, sha) AS (VALUES
+    ('vega', 'cup:open-cups:world-cup-history', 64,
+     'https://img.thesports.com/football/competition/da617cd58cd9cffaae0daec865457fb5.png',
+     '27eb02a79c3a0f5964d889705d6c70150f0157234089da32b8858dbee0f1a2cd'),
+    ('pitchapi', 'l_1XLtP0', 198,
+     'https://cdn.pitchapi.dev/images/leagues/676031121ec155fbaa398a16b88b1f94e51f9c1eabf90087480b70b59c7ec04d.webp',
+     '676031121ec155fbaa398a16b88b1f94e51f9c1eabf90087480b70b59c7ec04d')
+), changed AS (
+    UPDATE core.competitions c SET logo_asset_id=NULL, updated_at=now()
+    FROM confirmed f, core.provider_ids p, core.assets a
+    WHERE c.id=f.family AND p.entity_type='competition' AND p.provider::text=f.provider AND p.provider_key=f.key
+      AND p.entity_id=c.id AND a.id=c.logo_asset_id AND a.source_url=f.url AND a.sha256=decode(f.sha,'hex')
+    RETURNING c.id
+), versions AS (
+    SELECT 'competition_season'::ops.resource_kind AS kind, cs.id FROM core.competition_seasons cs WHERE cs.competition_id IN (SELECT id FROM changed)
+    UNION ALL SELECT 'home'::ops.resource_kind, 1 WHERE EXISTS (SELECT 1 FROM changed)
+)
+INSERT INTO ops.resource_versions(resource_kind,resource_id) SELECT kind,id FROM versions
+ON CONFLICT (resource_kind,resource_id) DO UPDATE
+SET version=ops.resource_versions.version+1, updated_at=now();
diff --git a/backend/sql/147_j1_standings_observation.sql b/backend/sql/147_j1_standings_observation.sql
new file mode 100644
index 0000000000..149ae88814
--- /dev/null
+++ b/backend/sql/147_j1_standings_observation.sql
@@ -0,0 +1,78 @@
+-- VI-29: J1's 2026/27 table was observed in November 2026 under Vega's native 2027
+-- edition (canonical 2027/28). The organiser's 380 fixtures matched the same season:
+-- 199 in the native 2026 edition and 181 in the native 2027 edition. A different
+-- table, a corrected edition and other competitions remain on migration 138's rules.
+SET LOCAL lock_timeout = '3s';
+
+-- The SHA-256 binds the complete table by club, rank, played, W/D/L, goals and points.
+-- It matches all 20 captured rows in public reads and in RDS. Match repeat observations
+-- before the first native 2027 kickoff, even if the old collector advanced as_of.
+CREATE FUNCTION api.j1_standings_exclusion()
+RETURNS TABLE (competition_season_id integer, season text, native_label text, is_current boolean)
+LANGUAGE sql STABLE SECURITY DEFINER SET search_path = pg_catalog AS $$
+  SELECT cs.id, se.label, cs.native_label, cs.is_current
+  FROM core.competition_seasons cs
+  JOIN core.seasons se ON se.id = cs.season_id
+  JOIN core.standings_official o ON o.competition_season_id = cs.id
+  CROSS JOIN LATERAL (SELECT api.public_id('team', o.team_id) AS club) p
+  WHERE cs.competition_id = api.internal_id('competition', 'l_2ApGa4')
+    AND se.label = '2027/2028' AND cs.native_label = '2027'
+    AND o.source = 'sportscore' AND o.stage IS NULL
+  GROUP BY cs.id, se.label, cs.native_label, cs.is_current
+  HAVING count(*) = 20
+     AND bool_and(o.group_name IS NULL AND o.as_of IS NOT NULL AND o.as_of < TIMESTAMPTZ '2027-02-13 11:00:00+00')
+     AND encode(sha256(convert_to(string_agg(
+           concat_ws('|', p.club, o.position, o.played, o.won, o.drawn, o.lost, o.goals_for, o.goals_against, o.points),
+           E'\n' ORDER BY p.club COLLATE "C"), 'UTF8')), 'hex') =
+         '9c5678ca3c14db97182f0ce37f629d660b10b8990520b18b141dd4c0d99ead6b'
+$$;
+
+CREATE OR REPLACE VIEW api.standings AS
+WITH excluded AS MATERIALIZED (
+  SELECT competition_season_id FROM api.j1_standings_exclusion()
+), authority AS NOT MATERIALIZED (
+  SELECT o.* FROM core.standings_official o
+  WHERE o.source = 'sportscore' AND o.stage IS NULL
+    AND NOT EXISTS (SELECT 1 FROM excluded x WHERE x.competition_season_id = o.competition_season_id)
+), unqualified AS NOT MATERIALIZED (
+  SELECT e.competition_season_id
+  FROM (SELECT DISTINCT o.competition_season_id FROM authority o) e
+  WHERE EXISTS (SELECT 1 FROM agg.standings a WHERE a.competition_season_id = e.competition_season_id)
+    AND EXISTS (
+      SELECT 1
+      FROM core.table_results(e.competition_season_id) c
+      FULL JOIN (SELECT o.team_id, o.basis, o.as_of FROM authority o
+                 WHERE o.competition_season_id = e.competition_season_id) o ON o.team_id = c.team_id
+      WHERE o.team_id IS NULL
+         OR (o.basis IS NOT NULL AND o.basis IS DISTINCT FROM coalesce(c.results, '{0,0,0,0,0,0}'))
+         OR (o.basis IS NULL AND EXISTS (
+               SELECT 1 FROM core.matches m LEFT JOIN core.rounds r ON r.id = m.round_id
+               WHERE m.competition_season_id = e.competition_season_id AND m.first_finished_at > o.as_of
+                 AND m.status = 'finished' AND m.home_score IS NOT NULL AND m.away_score IS NOT NULL
+                 AND coalesce(r.stage, 'regular') IN ('regular', 'group'))))
+), merged AS (
+  SELECT o.competition_season_id, o.stage, o.group_name, o.team_id, o.position, o.played, o.won, o.drawn,
+    o.lost, o.goals_for, o.goals_against, o.points, o.source::text, o.as_of
+  FROM authority o
+  WHERE NOT EXISTS (SELECT 1 FROM unqualified u WHERE u.competition_season_id = o.competition_season_id)
+  UNION ALL
+  SELECT a.competition_season_id, a.stage, a.group_name, a.team_id, a.position, a.played, a.won, a.drawn,
+    a.lost, a.goals_for, a.goals_against, a.points, 'vega', a.updated_at
+  FROM agg.standings a
+  -- The excluded edition's archive is also mispartitioned. It supplies no qualified fallback.
+  WHERE NOT EXISTS (SELECT 1 FROM excluded x WHERE x.competition_season_id = a.competition_season_id)
+    AND (NOT EXISTS (SELECT 1 FROM authority o WHERE o.competition_season_id = a.competition_season_id)
+         OR EXISTS (SELECT 1 FROM unqualified u WHERE u.competition_season_id = a.competition_season_id))
+)
+SELECT merged.*, api.public_id('team', merged.team_id) AS team_public_id, t.name AS team_name,
+  cr.s3_key AS crest_key, z.zone::text AS zone
+FROM merged
+JOIN core.teams t ON t.id = merged.team_id
+LEFT JOIN core.assets cr ON cr.id = t.crest_asset_id
+LEFT JOIN core.competition_zones z ON z.competition_season_id = merged.competition_season_id
+  AND merged.position BETWEEN z.position_from AND z.position_to AND merged.group_name IS NULL;
+
+INSERT INTO ops.resource_versions(resource_kind, resource_id)
+SELECT 'competition_season', competition_season_id FROM api.j1_standings_exclusion()
+ON CONFLICT (resource_kind, resource_id) DO UPDATE
+SET version = ops.resource_versions.version + 1, updated_at = now();
diff --git a/backend/sql/148_attested_archive_scores.sql b/backend/sql/148_attested_archive_scores.sql
new file mode 100644
index 0000000000..f89b5e3582
--- /dev/null
+++ b/backend/sql/148_attested_archive_scores.sql
@@ -0,0 +1,18 @@
+-- Keep the two verified Scottish football scores when a legacy writer replays the raw results.
+CREATE FUNCTION core.protect_attested_archive_score() RETURNS trigger
+LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+BEGIN
+    IF EXISTS (
+        SELECT 1 FROM core.archive_match_attestations a
+        WHERE a.season_id=OLD.season_id AND a.match_id=OLD.id AND a.proof ? 'new_score'
+          AND (NEW.home_score IS DISTINCT FROM (a.proof #>> '{new_score,0}')::smallint
+               OR NEW.away_score IS DISTINCT FROM (a.proof #>> '{new_score,1}')::smallint)
+    ) THEN
+        RAISE foreign_key_violation USING MESSAGE = 'the archive score is bound to an independent reviewed score';
+    END IF;
+    RETURN NEW;
+END $$;
+REVOKE ALL ON FUNCTION core.protect_attested_archive_score() FROM PUBLIC;
+CREATE TRIGGER protect_attested_archive_score BEFORE UPDATE OF home_score,away_score ON core.matches
+FOR EACH ROW WHEN (OLD.season_id IN (1924,1946) AND OLD.archive_key IS NOT NULL)
+EXECUTE FUNCTION core.protect_attested_archive_score();
diff --git a/backend/sql/149_validate_archive_attestation.sql b/backend/sql/149_validate_archive_attestation.sql
new file mode 100644
index 0000000000..a57978224c
--- /dev/null
+++ b/backend/sql/149_validate_archive_attestation.sql
@@ -0,0 +1,56 @@
+-- Bind the public alias to its physical archive target and exclude active former rows (VI-27).
+SET LOCAL lock_timeout = '3s';
+
+CREATE FUNCTION core.archive_attestation_matches_rows(a core.archive_match_attestations)
+RETURNS boolean LANGUAGE sql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+    SELECT EXISTS (
+        SELECT 1 FROM core.matches m
+        WHERE m.season_id=a.season_id AND m.id=a.match_id
+          AND m.archive_key=a.canonical_key AND m.match_date=a.canonical_date
+    )
+    AND (
+        a.former_key IS NULL OR NOT EXISTS (
+            SELECT 1 FROM core.matches m
+            WHERE m.season_id=a.season_id AND m.archive_key=a.former_key
+        )
+    )
+    AND (
+        a.former_id IS NULL OR (
+            NOT EXISTS (SELECT 1 FROM core.matches m WHERE m.id=a.former_id)
+            AND EXISTS (
+                SELECT 1 FROM ops.archive_removals r
+                WHERE r.kind='match' AND r.season_id=a.season_id AND r.id=a.former_id
+                  AND r.archive_key=a.former_key
+            )
+        )
+    )
+$$;
+REVOKE ALL ON FUNCTION core.archive_attestation_matches_rows(core.archive_match_attestations) FROM PUBLIC;
+
+-- The local candidate can already hold completed decisions. Verify the same contract on upgrade.
+DO $$
+BEGIN
+    IF EXISTS (
+        SELECT 1 FROM core.archive_match_attestations a WHERE NOT core.archive_attestation_matches_rows(a)
+    ) THEN
+        RAISE foreign_key_violation USING MESSAGE = 'an existing archive attestation conflicts with active matches';
+    END IF;
+END
+$$;
+
+CREATE FUNCTION core.enforce_archive_attestation_rows() RETURNS trigger
+LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, pg_temp AS $$
+BEGIN
+    IF NEW.former_key IS NOT NULL THEN
+        PERFORM pg_advisory_xact_lock(hashtext('vega.archives.apply'));
+    END IF;
+    PERFORM 1 FROM core.matches m WHERE m.season_id=NEW.season_id AND m.id=NEW.match_id FOR SHARE;
+    IF NOT core.archive_attestation_matches_rows(NEW) THEN
+        RAISE foreign_key_violation USING MESSAGE = 'the archive attestation does not match the target or names an active former match';
+    END IF;
+    RETURN NEW;
+END
+$$;
+REVOKE ALL ON FUNCTION core.enforce_archive_attestation_rows() FROM PUBLIC;
+CREATE TRIGGER enforce_archive_attestation_rows BEFORE INSERT OR UPDATE ON core.archive_match_attestations
+FOR EACH ROW EXECUTE FUNCTION core.enforce_archive_attestation_rows();
