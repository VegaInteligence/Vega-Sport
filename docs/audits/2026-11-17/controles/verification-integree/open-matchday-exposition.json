      "sql": "WITH v AS MATERIALIZED (\n        SELECT s.match_id,jsonb_strip_nulls(to_jsonb(s) - ARRAY['season_id','team_id','match_id','period','updated_at',\n          'total_shots','shots_on_target','fouls','corners','yellow_cards','red_cards']) unrelated\n        FROM core.matches m JOIN core.team_match_stats s ON (s.match_id,s.season_id)=(m.id,m.season_id) WHERE m.source='open_matchday')\n        SELECT count(*) team_periods,count(DISTINCT match_id) matches_with_stats,count(*) FILTER(WHERE unrelated <> '{}'::jsonb) rows_with_other_values,\n        count(DISTINCT match_id) FILTER(WHERE unrelated<>'{}'::jsonb) matches_with_other_values\n        FROM v",
